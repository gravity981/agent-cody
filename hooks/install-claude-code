#!/usr/bin/env python3
"""Installs Cody's Claude Code hooks at user level (AGT-03, AGT-11; spec/architecture.md 4.1).

Merges the hooks into $CLAUDE_CONFIG_DIR/settings.json or ~/.claude/settings.json,
keeps every other setting, and replaces Cody hooks installed earlier.

  install-claude-code               install (or update)
  install-claude-code --uninstall   remove Cody's hooks
  install-claude-code --record FILE also append every payload to FILE (test fixtures)

Run it once on the host and once in a devcontainer that uses the shared
claude-config volume. Standard library only.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import sys
from pathlib import Path

MARKER = "/hooks/claude-code"  # identifies Cody's hooks in settings.json
HOSTS = ["127.0.0.1", "host.docker.internal", "172.17.0.1"]  # host, then containers
PORT = 8765
TIMEOUT_S = 2  # the hook's own limit; the command itself takes at most ~0.9 s

EVENTS = [
    "SessionStart",
    "UserPromptSubmit",
    "PreToolUse",
    "PostToolUse",
    "PostToolUseFailure",
    "PermissionRequest",
    "Notification",
    "Stop",
    "StopFailure",
    "SessionEnd",
]


def hook_command(record: str | None = None) -> str:
    """The inline hook: forwards the payload, never prints, always exits 0 (AGT-07)."""
    save = f"printf '%s\\n' \"$p\" >> {shlex.quote(record)}; " if record else ""
    return (
        f"p=$(cat); {save}for h in {' '.join(HOSTS)}; do "
        f"printf '%s' \"$p\" | curl -s -o /dev/null --connect-timeout 0.3 -m 0.3 -H 'Expect:' "
        f'--data-binary @- "http://$h:{PORT}{MARKER}" 2>/dev/null && break; '
        "done; exit 0"
    )


def is_cody(group: dict) -> bool:
    return any(MARKER in h.get("command", "") for h in group.get("hooks", []))


def merged(settings: dict, record: str | None, uninstall: bool) -> dict:
    hooks = settings.setdefault("hooks", {})
    for event in EVENTS:
        groups = [g for g in hooks.get(event, []) if not is_cody(g)]
        if not uninstall:
            groups.append(
                {
                    "hooks": [
                        {"type": "command", "command": hook_command(record), "timeout": TIMEOUT_S}
                    ]
                }
            )
        if groups:
            hooks[event] = groups
        else:
            hooks.pop(event, None)
    if not hooks:
        del settings["hooks"]
    return settings


def settings_path() -> Path:
    base = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(base) if base else Path.home() / ".claude"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--uninstall", action="store_true", help="remove Cody's hooks")
    parser.add_argument("--record", metavar="FILE", help="also append every payload to FILE")
    parser.add_argument("--settings", type=Path, help="settings.json to change (default: user's)")
    args = parser.parse_args(argv)

    path = args.settings or settings_path() / "settings.json"
    settings = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    if not isinstance(settings, dict):
        print(f"{path}: not a JSON object", file=sys.stderr)
        return 1
    if path.exists():
        shutil.copy2(path, path.with_suffix(".json.bak"))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(merged(settings, args.record, args.uninstall), indent=2) + "\n")
    action = "removed from" if args.uninstall else "installed in"
    print(f"Cody's Claude Code hooks {action} {path}")
    if shutil.which("curl") is None and not args.uninstall:
        print("warning: curl is not installed here; the hooks need it", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
