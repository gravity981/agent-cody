{
  // The development environment (VS Code "Reopen in Container"). The workflows run
  // the ci/ entry points in it too (spec/delivery.md 2). The project's toolchain is
  // in the Dockerfile, with pinned versions (spec/architecture.md 5.1).
  "name": "Cody",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    // gh: lets Claude read issues, pull requests and CI runs
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {},
    // Docker CLI using the host's Docker: builds and pushes the bridge image (ci/publish)
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {}
  },
  "mounts": [
    // Claude Code login and settings survive container rebuilds, shared across projects
    "source=claude-config,target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  // Installs the workspace members (bridge, cad, tools) into the prebuilt environment
  "postCreateCommand": "uv sync --frozen",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "editorconfig.editorconfig",
        "github.vscode-github-actions",
        "bierner.markdown-mermaid",
        "davidanson.vscode-markdownlint",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-vscode.cpptools",
        "xaver.clang-format",
        "timonwong.shellcheck",
        "bernhard-42.ocp-cad-viewer"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/cody-venv/bin/python"
      }
    }
  },
  "remoteUser": "vscode"
}
