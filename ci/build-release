#!/usr/bin/env bash
# ci/build-release (spec/delivery.md 2): release files into $RELEASE_DIR, with
# VERSION and COMMIT baked in and the version in each file name.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=ci/lib.sh
source ci/lib.sh

: "${RELEASE_DIR:?RELEASE_DIR must be set}"
VERSION=$(cody_version)
COMMIT=$(cody_commit)
export VERSION COMMIT
echo "Release files for $VERSION ($COMMIT) into $RELEASE_DIR"
mkdir -p "$RELEASE_DIR"
RELEASE_DIR=$(cd "$RELEASE_DIR" && pwd -P)

# Firmware: one combined image (bootloader, partitions, app), flashed at 0x0
(cd firmware && pio run --environment esp32c3 --jobs 15)
cp firmware/.pio/build/esp32c3/firmware.factory.bin "$RELEASE_DIR/cody-firmware-$VERSION.bin"

# Host command (BRG-11, BRG-12): the script with its version filled in
sed -e "s#^CODY_VERSION=\"0.0.0+unknown\"#CODY_VERSION=\"$VERSION\"#" cli/cody > "$RELEASE_DIR/cody-$VERSION"
chmod +x "$RELEASE_DIR/cody-$VERSION"

# Windows tray app and per-user installer (BRG-16 – BRG-18)
RELEASE_DIR="$RELEASE_DIR" ci/build-windows-installer

# Wiring diagram (ELE-07)
cp electronics/wiring.svg "$RELEASE_DIR/cody-wiring-$VERSION.svg"

# Build documentation (DOC-06): CSV from Markdown and PDF with the pinned renderer
uv run --frozen python -m cody_tools.build_docs --version "$VERSION" --release-dir "$RELEASE_DIR"

# Printable CAD parts (FIG-11): flat, versioned STL files; omit the STEP assembly
uv run --frozen python -m cody_cad.mechanism \
    --output "$RELEASE_DIR" --version "$VERSION" --stl-only

# Claude Code hook installer (AGT-03, AGT-11): Python, standard library only
cp hooks/install-claude-code "$RELEASE_DIR/cody-install-claude-code-$VERSION"
chmod +x "$RELEASE_DIR/cody-install-claude-code-$VERSION"

# Copilot user-level hook configuration and platform forwarders (AGT-04, AGT-09)
cp hooks/copilot-hooks.json "$RELEASE_DIR/cody-copilot-hooks-$VERSION.json"
cp hooks/cody-forward.sh "$RELEASE_DIR/cody-copilot-forward-$VERSION.sh"
chmod +x "$RELEASE_DIR/cody-copilot-forward-$VERSION.sh"
cp hooks/cody-forward.ps1 "$RELEASE_DIR/cody-copilot-forward-$VERSION.ps1"

cp LICENSE "$RELEASE_DIR/LICENSE"

ls -l "$RELEASE_DIR"
